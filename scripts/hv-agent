def expected_authority_workflow() -> bytes:
    """Return the fixed workflow permitted in the public authority repository."""
    template = (
        artifact_root() / "templates" / "github" / "agent-policy-authority.yml"
    ).read_text(encoding="utf-8")
    needle = (
        "    runs-on: "
        "${{ format('arc-{0}', github.repository_owner) }}\n"
    )
    if template.count(needle) != 1:
        raise ValueError(
            "canonical lifecycle authority must contain exactly one "
            "repository-owner organization alias"
        )
    return template.encode()


