def policy_lock_errors(value: Any, label: str = "policy lock") -> list[str]:
    fields = {
        "schema", "artifact", "generation", "policy_revision",
        "source_commit", "source_tree_sha256",
    }
    if not isinstance(value, dict):
        return [f"{label} must be an object"]
    errors: list[str] = []
    if set(value) not in (fields, fields | {"rollout"}):
        errors.append(f"{label} has unexpected or missing fields")
    if value.get("schema") != "hv-agent-policy-lock:v1":
        errors.append(f"{label} has an unsupported schema")
    artifact = value.get("artifact")
    if not isinstance(artifact, str) or not re.fullmatch(
        r"ghcr\.io/happyvertical/agent-policy@sha256:[0-9a-f]{64}", artifact,
    ):
        errors.append(f"{label} artifact must be the immutable HappyVertical policy digest")
    generation = value.get("generation")
    if isinstance(generation, bool) or not isinstance(generation, int) or generation < 1:
        errors.append(f"{label} generation must be a positive integer")
    elif generation >= ROLLOUT_METADATA_GENERATION and "rollout" not in value:
        errors.append(
            f"{label} generation {generation} must declare explicit rollout metadata"
        )
    revision = value.get("policy_revision")
    if not isinstance(revision, str) or not revision:
        errors.append(f"{label} policy_revision must be a non-empty string")
    commit = value.get("source_commit")
    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
        errors.append(f"{label} source_commit must be a lowercase 40-character Git OID")
    tree = value.get("source_tree_sha256")
    if not isinstance(tree, str) or not re.fullmatch(r"[0-9a-f]{64}", tree):
        errors.append(f"{label} source_tree_sha256 must be a lowercase SHA-256")
    if "rollout" in value:
        errors.extend(policy_channels.rollout_metadata_errors(
            value["rollout"], f"{label} rollout",
        ))
    return errors


def authority_substrate_predecessor(
    generation: Any, selected_stable: Any, bind: bool = True,
) -> tuple[dict[str, str], list[str]]:
    """Return the predecessor substrate digests this runtime also accepts."""
    path = artifact_root() / AUTHORITY_SUBSTRATE_PREDECESSOR_PATH
    if not path.is_file():
        return {}, []
    try:
        pin = load(path)
        current = {
            relative.as_posix():
                hashlib.sha256((artifact_root() / relative).read_bytes()).hexdigest()
            for relative in AUTHORITY_SUBSTRATE_SOURCE_PATHS
        }
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        return {}, [f"{path}: {exc}"]
    return lifecycle.bound_authority_substrate_predecessor_components(
        pin, generation, current, selected_stable, str(path), bind,
    )


def authority_repository_errors(repo: Path) -> list[str]:
    """Bind the authority repository candidate lock to this signed runtime."""
    errors: list[str] = []
    workflow = repo / LEGACY_WORKFLOW_PATH
    lock_path = repo / AUTHORITY_LOCK_PATH
    channels_path = repo / AUTHORITY_CHANNELS_PATH
    try:
        lock = load(lock_path)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        return [str(exc)]
    lock_errors = policy_lock_errors(lock, str(lock_path))
    errors.extend(lock_errors)
    if lock_errors:
        return errors
    legacy_bootstrap = not channels_path.exists()
    if legacy_bootstrap and lock.get("generation") != 7:
        errors.append(
            f"{channels_path}: may be absent only while stable generation 7 bootstraps "
            "the central channel authority"
        )
    if legacy_bootstrap and os.environ.get("GITHUB_ACTIONS") == "true":
        protected = command([
            "gh", "api",
            "repos/happyvertical/.github/contents/.github/agent-policy-channels.json?ref=main",
        ], check=False)
        if protected.returncode == 0:
            errors.append(
                f"{channels_path}: central policy channels cannot be removed after bootstrap"
            )
        elif "HTTP 404" not in (protected.stderr + protected.stdout):
            errors.append(
                f"{channels_path}: cannot verify whether protected bootstrap state exists"
            )
    # The authoritative manifest load below reports its own failure; the
    # generation is read early here only to bind the predecessor pin.
    try:
        generation = load(artifact_root() / "policy-artifact.json").get("generation")
    except (OSError, ValueError, json.JSONDecodeError):
        generation = None
    if legacy_bootstrap:
        # The generation-7 bootstrap has no channels to record an outgoing
        # stable, so it keeps binding to the lock exactly as before.
        selected_stable_lock, bind_selected_stable = lock, True
    else:
        try:
            pin_channel_state: Any = load(channels_path)
        except (OSError, ValueError, json.JSONDecodeError):
            pin_channel_state = None
        selected_stable_lock, bind_selected_stable = lifecycle.selected_stable_binding(
            lock, pin_channel_state, generation,
        )
    predecessor, predecessor_errors = authority_substrate_predecessor(
        generation, selected_stable_lock, bind_selected_stable,
    )
    errors.extend(predecessor_errors)

    def substrate_error(source: Path, installed: Path, expected: bytes, drift: str) -> str | None:
        try:
            content = installed.read_bytes()
        except OSError as exc:
            return str(exc)
        if lifecycle.authority_substrate_matches(
            content, expected, predecessor.get(source.as_posix()),
        ):
            return None
        return f"{installed}: {drift}"

    selector = repo / POLICY_CHANNEL_SELECTOR_PATH
    try:
        if legacy_bootstrap:
            if workflow.read_bytes() != expected_generation6_authority_workflow():
                errors.append(
                    f"{workflow}: missing or differs from the canonical "
                    "generation-6 bootstrap workflow"
                )
        else:
            error = substrate_error(
                POLICY_CHANNEL_AUTHORITY_WORKFLOW_TEMPLATE, workflow,
                expected_authority_workflow(),
                "missing or differs from the canonical source-owned authority workflow",
            )
            if error:
                errors.append(error)
    except (OSError, ValueError) as exc:
        errors.append(str(exc))
    if not legacy_bootstrap:
        try:
            error = substrate_error(
                POLICY_CHANNEL_SELECTOR_PATH, selector, expected_policy_channel_selector(),
                "missing or differs from canonical bootstrap selector",
            )
            if error:
                errors.append(error)
        except OSError as exc:
            errors.append(str(exc))
        rollout_workflow = repo / POLICY_CHANNEL_ROLLOUT_WORKFLOW_PATH
        try:
            error = substrate_error(
                POLICY_CHANNEL_ROLLOUT_WORKFLOW_TEMPLATE, rollout_workflow,
                expected_policy_channel_rollout_workflow(),
                "missing or differs from the canonical protected channel rollout workflow",
            )
            if error:
                errors.append(error)
        except OSError as exc:
            errors.append(str(exc))
        for relative in POLICY_CHANNEL_AUTHORITY_TOOL_PATHS:
            installed = repo / relative
            try:
                error = substrate_error(
                    relative, installed, (artifact_root() / relative).read_bytes(),
                    "missing or differs from canonical channel rollout tooling",
                )
                if error:
                    errors.append(error)
            except OSError as exc:
                errors.append(str(exc))
    workflow_root = repo / ".github" / "workflows"
    if workflow_root.is_dir():
        for candidate in sorted(workflow_root.iterdir()):
            if candidate.suffix not in {".yml", ".yaml"} or candidate == workflow:
                continue
            try:
                text = candidate.read_text(encoding="utf-8")
            except OSError as exc:
                errors.append(str(exc))
                continue
            errors.extend(
                f"{candidate}: {error}"
                for error in lifecycle.validation_workflow_check_context_errors(
                    text, require_jobs=False,
                )
            )
    if legacy_bootstrap:
        selected_channel, selected_lock = "stable", lock
    else:
        try:
            channel_state = load(channels_path)
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            errors.append(str(exc))
            return errors
        channel_errors = policy_channels.channel_state_errors(
            channel_state, str(channels_path),
        )
        errors.extend(channel_errors)
        if channel_errors:
            return errors
        if channel_state["channels"]["stable"] != lock:
            errors.append(f"{channels_path}: stable channel differs from {lock_path}")
            return errors
        try:
            selected_channel, selected_lock = policy_channels.select_lock(
                channel_state, AUTHORITY_REPOSITORY_NODE_ID,
            )
        except policy_channels.PolicyChannelError as exc:
            errors.append(f"{channels_path}: cannot select authority channel: {exc}")
            return errors
    manifest_path = artifact_root() / "policy-artifact.json"
    try:
        artifact = load(manifest_path)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        errors.append(f"signed runtime lacks a valid artifact manifest: {exc}")
        return errors
    expected_artifact = os.environ.get("POLICY_ARTIFACT") or os.environ.get("HV_POLICY_ARTIFACT")
    if not expected_artifact:
        errors.append("authority audit requires the selected signed POLICY_ARTIFACT identity")
    elif selected_lock.get("artifact") != expected_artifact:
        errors.append(
            f"{channels_path}: selected {selected_channel} artifact does not match "
            "the signed policy runtime"
        )
    for field in [
        "generation", "policy_revision", "source_commit", "source_tree_sha256", "rollout",
    ]:
        if selected_lock.get(field) != artifact.get(field):
            errors.append(
                f"{channels_path}: selected {selected_channel} {field} does not match "
                "the signed artifact manifest"
            )
    if artifact.get("source_dirty") is not False:
        errors.append("selected signed artifact manifest records dirty source")
    return errors


def agent_policy_workflow(manifest: dict[str, Any]) -> str | None:
    """Return the deprecated folded workflow selector, if still configured."""
    runtime = manifest.get("runtime", {})
    value = runtime.get("agent_policy_workflow") if isinstance(runtime, dict) else None
    if value is None:
        return None
    if not isinstance(value, str) or not AGENT_POLICY_WORKFLOW_PATTERN.fullmatch(value):
        raise ValueError("runtime.agent_policy_workflow must be a repository workflow path")
    return value


def agent_validation_workflow(manifest: dict[str, Any]) -> str | None:
    runtime = manifest.get("runtime", {})
    value = runtime.get("agent_validation_workflow") if isinstance(runtime, dict) else None
    if value is None:
        return None
    if not isinstance(value, str) or not AGENT_POLICY_WORKFLOW_PATTERN.fullmatch(value):
        raise ValueError("runtime.agent_validation_workflow must be a repository workflow path")
    if Path(value) == LEGACY_WORKFLOW_PATH:
        raise ValueError(
            "runtime.agent_validation_workflow must differ from the dedicated "
            f"lifecycle workflow {LEGACY_WORKFLOW_PATH}"
        )
    return value


def expected_validation_lifecycle_dependency(manifest: dict[str, Any]) -> str:
    runtime = manifest.get("runtime", {})
    runner = runtime.get("agent_policy_runner", DEFAULT_AGENT_POLICY_RUNNER) if isinstance(runtime, dict) else ""
    if not isinstance(runner, str) or not AGENT_POLICY_RUNNER_PATTERN.fullmatch(runner):
        raise ValueError("runtime.agent_policy_runner must be a literal GitHub runner label")
    template = (
        artifact_root() / "templates" / "github"
        / "agent-validation-lifecycle-dependency.yml"
    ).read_text(encoding="utf-8")
    needle = f"    runs-on: {DEFAULT_AGENT_POLICY_RUNNER}\n"
    if template.count(needle) != 1:
        raise ValueError("validation lifecycle dependency must contain one default runner")
    return template.replace(needle, f"    runs-on: {runner}\n", 1)


def audit_repository(repo: Path) -> list[str]:
    errors: list[str] = []
    manifest_path = repo / ".agents" / "project.yaml"
    agents_path = repo / "AGENTS.md"
    manifest: dict[str, Any] = {}
    try:
        manifest = load(manifest_path)
        if manifest.get("schema") != "https://happyvertical.com/schemas/agent-project/v1":
            errors.append(f"{manifest_path}: unsupported schema")
        if manifest.get("policy", {}).get("revision") != POLICY_REVISION:
            errors.append(f"{manifest_path}: stale policy revision")
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        errors.append(str(exc))
    try:
        guidance = agents_path.read_text(encoding="utf-8")
        if len(guidance.encode()) > ROOT_GUIDANCE_MAX:
            errors.append(f"{agents_path}: exceeds {ROOT_GUIDANCE_MAX} bytes")
        kernel = (artifact_root() / "policy" / "agent-development-kernel.md").read_bytes()
        expected_hash = hashlib.sha256(kernel).hexdigest()
        block = re.search(r"<!-- hv-managed-policy:start.*?<!-- hv-managed-policy:end -->", guidance, re.S)
        # A compatibility-stage repository migrated by the previous stable
        # release keeps that release's exact generated kernel block until its
        # pin advances; the grace is bounded to the vendored previous-release
        # kernel and never applies at the diagnostic stage.
        grace_block = None
        runtime_policy = manifest.get("runtime") if isinstance(manifest.get("runtime"), dict) else {}
        if (runtime_policy or {}).get("agent_lifecycle_stage", "compatibility") == "compatibility":
            try:
                compat_kernel = (
                    artifact_root() / "policy" / "agent-development-kernel-compat-v1.0.9.md"
                ).read_bytes()
                compat_hash = hashlib.sha256(compat_kernel).hexdigest()
                compat_bullets = [
                    line for line in compat_kernel.decode().splitlines()
                    if line.startswith("- ")
                ]
                grace_block = (
                    f"<!-- hv-managed-policy:start revision={POLICY_REVISION} sha256={compat_hash} -->\n\n"
                    "## Shared development kernel\n\n"
                    + "\n".join(compat_bullets)
                    + "\n\n<!-- hv-managed-policy:end -->"
                )
            except (OSError, UnicodeDecodeError):
                grace_block = None
        grace_ok = grace_block is not None and block is not None \
            and block.group(0) == grace_block
        marker = re.search(r"hv-managed-policy:start revision=([^ ]+) sha256=([a-f0-9]{64})", guidance)
        if not grace_ok and (
            not marker or marker.group(1) != POLICY_REVISION or marker.group(2) != expected_hash
        ):
            errors.append(f"{agents_path}: stale or edited managed policy block")
        bullets = [line for line in kernel.decode().splitlines() if line.startswith("- ")]
        expected_block = (
            f"<!-- hv-managed-policy:start revision={POLICY_REVISION} sha256={expected_hash} -->\n\n"
            "## Shared development kernel\n\n"
            + "\n".join(bullets)
            + "\n\n<!-- hv-managed-policy:end -->"
        )
        if not grace_ok and (not block or block.group(0) != expected_block):
            errors.append(f"{agents_path}: generated policy block was edited")
    except OSError as exc:
        errors.append(str(exc))
    repository_id = os.environ.get("GITHUB_REPOSITORY_ID")
    if manifest:
        errors.extend(formatting_rollout.audit(
            repo,
            artifact_root(),
            manifest,
            source_repository=(
                os.environ.get("GITHUB_ACTIONS") == "true"
                and repository_id in {
                    CONTROL_PLANE_REPOSITORY_ID, AUTHORITY_REPOSITORY_ID,
                }
            ),
        ))
    for relative in ["CLAUDE.md", "GEMINI.md", ".github/copilot-instructions.md"]:
        path = repo / relative
        try:
            if "AGENTS.md" not in path.read_text(encoding="utf-8"):
                errors.append(f"{path}: invalid adapter")
        except OSError as exc:
            errors.append(str(exc))
    # The control-plane repository has a local validation workflow. The public
    # authority repository carries the fixed required workflow and monotonic
    # lock. Other repositories carry only diagnostic consumer integrations.
    if repository_id == AUTHORITY_REPOSITORY_ID:
        errors.extend(authority_repository_errors(repo))
    elif repository_id != CONTROL_PLANE_REPOSITORY_ID:
        try:
            folded = agent_policy_workflow(manifest)
            corrective = "; run scripts/hv-agent migrate-repo . --profile happyvertical --apply"
            if folded and Path(folded) != LEGACY_WORKFLOW_PATH:
                errors.append(
                    f"{repo / folded}: hazardous folded lifecycle configuration remains{corrective}"
                )
            workflow = repo / LEGACY_WORKFLOW_PATH
            accepted = [
                expected_lifecycle_workflow(manifest),
                expected_generation6_lifecycle_workflow(manifest),
            ]
            runtime = manifest.get("runtime", {})
            stage = runtime.get("agent_lifecycle_stage", "compatibility") \
                if isinstance(runtime, dict) else ""
            if stage == "compatibility":
                accepted.append(
                    expected_previous_compatibility_lifecycle_workflow(manifest)
                )
            if artifact_is_runtime_only_rollout():
                accepted.append(
                    expected_runtime_only_predecessor_lifecycle_workflow(manifest)
                )
            if workflow.read_bytes() not in accepted:
                errors.append(f"{workflow}: missing or differs from the canonical lifecycle workflow")
            validation = agent_validation_workflow(manifest)
            required_checks = manifest.get("github", {}).get("required_status_checks", [])
            if isinstance(required_checks, list) and required_checks and validation is None:
                errors.append(
                    f"{repo / '.agents/project.yaml'}: managed required checks require "
                    "runtime.agent_validation_workflow; restore the repository's required "
                    f"code-validation workflow selector{corrective}"
                )
            if validation:
                validation_path = repo / validation
                text = validation_path.read_text(encoding="utf-8")
                if "# hv-agent-policy:start" in text or "# hv-agent-policy:end" in text:
                    errors.append(
                        f"{validation_path}: validation workflow still contains a folded "
                        f"lifecycle block{corrective}"
                    )
                dependency = expected_validation_lifecycle_dependency(manifest)
                has_dependency_marker = (
                    "# hv-agent-validation-dependency:start" in text
                    or "# hv-agent-validation-dependency:end" in text
                )
                if has_dependency_marker and not lifecycle.exact_managed_top_level_mapping_child_block(
                    text,
                    dependency,
                    "# hv-agent-validation-dependency:start",
                    "# hv-agent-validation-dependency:end",
                    2,
                ):
                    errors.append(
                        f"{validation_path}: validation lifecycle dependency differs "
                        f"from canonical{corrective}"
                    )
                if lifecycle.workflow_references_lifecycle_job(text) and not has_dependency_marker:
                    errors.append(
                        f"{validation_path}: repository jobs depend on the isolated lifecycle "
                        f"job without the managed validation dependency{corrective}"
                    )
                errors.extend(
                    f"{validation_path}: {error}{corrective}"
                    for error in lifecycle.validation_workflow_trigger_errors(text)
                )
            workflow_root = repo / ".github" / "workflows"
            if workflow_root.is_dir():
                for candidate in sorted(workflow_root.iterdir()):
                    if candidate.suffix not in {".yml", ".yaml"} or candidate == workflow:
                        continue
                    text = candidate.read_text(encoding="utf-8")
                    if "# hv-agent-policy:start" in text or "# hv-agent-policy:end" in text:
                        message = f"{candidate}: untracked folded lifecycle block remains{corrective}"
                        if message not in errors:
                            errors.append(message)
                    if validation is None or candidate != repo / validation:
                        errors.extend(
                            f"{candidate}: {error}{corrective}"
                            for error in lifecycle.validation_workflow_check_context_errors(
                                text, require_jobs=False,
                            )
                        )
        except (OSError, ValueError) as exc:
            errors.append(str(exc))
    return errors


def check_pr(repo: Path, number: str) -> tuple[list[str], list[str]]:
    """Return this revision's rejections, and notes explaining which remedy fits."""
    errors = audit_repository(repo)
    notes: list[str] = []
    manifest = load(repo / ".agents" / "project.yaml")
    manifest_repository = lifecycle.forge_repository(manifest)
    trusted_repository = os.environ.get("GITHUB_REPOSITORY")
    repository = trusted_repository or manifest_repository
    if trusted_repository and manifest_repository != trusted_repository:
        errors.append(
            f"tracker.repository {manifest_repository} does not match trusted workflow "
            f"repository {trusted_repository}; restore generated project policy"
        )
    pr = lifecycle_pull_request(repository, number)
    if lifecycle.validation_workflow_evidence_required(
        os.environ.get("EVENT_NAME"), os.environ.get("EVENT_ACTION"),
    ):
        try:
            workflow_path, timeline = github.validation_workflow_evidence(
                command_json, RuntimeError, repository, pr,
                require_selector=(
                    os.environ.get("GITHUB_REPOSITORY_ID") == CONTROL_PLANE_REPOSITORY_ID
                ),
                canonical_lifecycle=expected_lifecycle_workflow,
            )
        except RuntimeError as exc:
            errors.append(str(exc))
        else:
            if workflow_path:
                error = lifecycle.validation_workflow_transition_error(
                    pr, workflow_path, timeline,
                )
                if error:
                    errors.append(error)
    links = pr.get("closingIssuesReferences", [])
    errors.extend(lifecycle.closing_issue_reference_errors(pr, repository))
    default_branch = pr.get("baseRepositoryDefaultBranch")
    base_branch = pr.get("baseRefName")
    if not isinstance(default_branch, str) or not default_branch \
            or not isinstance(base_branch, str) or not base_branch:
        errors.append("PR base branch metadata is unavailable; reread GitHub before lifecycle validation")
    else:
        check_commit_references = base_branch == default_branch
        errors.extend(lifecycle.undeclared_closing_reference_errors(
            pr,
            pull_request_commits(repository, str(number)) if check_commit_references else [],
            repository,
            check_commit_references=check_commit_references,
        ))
    linked_issues = [
        lifecycle_issue_state(repository, str(link["number"]))
        for link in links
        if not lifecycle.closing_issue_reference_errors(
            {"closingIssuesReferences": [link]}, repository,
        )
    ]
    needs_release_evidence = any(
        issue.get("authorityMetadataComplete")
        and any(
            claim.get("released_at")
            and claim.get("release_reason") in lifecycle.PR_BOUND_RELEASE_REASONS
            for _comment, claim in lifecycle.claim_comment_records(issue)[0]
        )
        for issue in linked_issues
    )
    head_oid = str(pr.get("headRefOid") or "")
    pr["commitStatuses"] = (
        commit_statuses(repository, head_oid)
        if needs_release_evidence and head_oid else []
    )
    metadata = parse_marked(pr.get("body", ""), RUN_MARKER, "hv-agent-run:v1")
    if not metadata:
        branch = str(pr.get("headRefName", ""))
        claimed_issue = any(
            records or claim_errors
            for issue in linked_issues
            for records, claim_errors in [lifecycle.claim_comment_records(issue)]
        )
        if AGENT_BRANCH_PATTERN.match(branch) or claimed_issue:
            errors.append(
                "agent-authored PR is missing valid hv-agent-run:v1 metadata; repair the "
                "PR body and keep the PR ready"
            )
        elif BLOCKED_LABEL in lifecycle.label_names(pr):
            errors.append(
                "PR has status: blocked; resolve the blocker and remove the label before merge"
            )
        return errors, notes
    errors.extend(
        lifecycle.validate_agent_pr(
            pr,
            metadata,
            linked_issues,
            POLICY_REVISION,
            merge_group=os.environ.get("EVENT_NAME") == "merge_group",
            repository=repository,
        )
    )
    if errors:
        notes.extend(
            note for issue in linked_issues
            if (note := lifecycle.release_settlement_pending(issue, metadata, pr, errors))
        )
    return errors, notes


def main() -> int:
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command_name", required=True)
    audit = commands.add_parser("audit")
    audit.add_argument("repo", nargs="?", default=".")
    check = commands.add_parser("check-pr")
    check.add_argument("number")
    check.add_argument("repo", nargs="?", default=".")
    claim = commands.add_parser("claim")
    claim.add_argument("issue", type=int)
    claim.add_argument("--repo-path", default=".")
    claim.add_argument("--repo")
    claim.add_argument("--runtime", required=True)
    claim.add_argument("--owner", required=True)
    claim.add_argument("--session", required=True)
    claim.add_argument("--branch")
    claim.add_argument("--worktree")
    claim.add_argument("--no-project", action="store_true")
    heartbeat = commands.add_parser("heartbeat")
    heartbeat.add_argument("issue", type=int)
    heartbeat.add_argument("--repo-path", default=".")
    heartbeat.add_argument("--session", required=True)
    heartbeat.add_argument("--repair-legacy-owner")
    heartbeat.add_argument("--branch")
    heartbeat.add_argument("--worktree")
    release = commands.add_parser("release")
    release.add_argument("issue", type=int)
    release.add_argument("--repo-path", default=".")
    release.add_argument("--repo")
    release.add_argument("--session", required=True)
    release.add_argument("--claim-comment-id")
    release.add_argument("--message")
    release_mode = release.add_mutually_exclusive_group()
    release_mode.add_argument("--blocked", action="store_true")
    release_mode.add_argument("--abandon", action="store_true")
    release.add_argument("--no-project", action="store_true")
    reconcile = commands.add_parser("reconcile")
    reconcile.add_argument("issue", nargs="?", type=int)
    reconcile.add_argument("--repo-path", default=".")
    reconcile.add_argument("--repo")
    reconcile.add_argument("--all", action="store_true")
    reconcile.add_argument("--apply", action="store_true")
    reconcile.add_argument("--no-project", action="store_true")
    project_sync = commands.add_parser("project-sync")
    project_sync.add_argument("--repo-path", default=".")
    project_sync.add_argument(
        "--item", nargs=2, action="append", required=True,
        metavar=("ISSUE_URL", "STATUS"),
    )
    project_sync.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    try:
        budget_command = {
            "claim": "claim",
            "heartbeat": "heartbeat",
            "release": "release",
            "check-pr": "check-pr",
        }.get(args.command_name)
        if args.command_name == "reconcile":
            budget_command = (
                "reconcile-background"
                if bool(getattr(args, "all", False))
                else "reconcile-targeted"
            )
        if args.command_name == "project-sync":
            args.project_requests = github.project_status_requests(args.item)
            GRAPHQL.preflight_project_sync(len(args.project_requests))
        if budget_command:
            GRAPHQL.preflight(budget_command)
        if args.command_name == "claim":
            return claim_issue(args)
        if args.command_name == "heartbeat":
            return heartbeat_issue(args)
        if args.command_name == "release":
            return release_issue(args)
        if args.command_name == "reconcile":
            return reconcile_issues(args)
        if args.command_name == "project-sync":
            return project_sync_items(args)
        repo = Path(args.repo).resolve()
        errors, notes = (
            (audit_repository(repo), [])
            if args.command_name == "audit" else check_pr(repo, args.number)
        )
        for error in errors:
            print(f"ERROR {error}")
        for note in notes:
            print(f"NOTE {note}")
        for annotation in lifecycle.lifecycle_annotations(
            errors, notes,
            github_actions=os.environ.get("GITHUB_ACTIONS") == "true",
        ):
            print(annotation)
        if errors:
            return 1
        print("Agent Policy / lifecycle passed")
        return 0
    finally:
        summary = GRAPHQL.summary()
        if summary:
            print(summary, file=sys.stderr)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KeyError, OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        print(f"ERROR {exc}", file=sys.stderr)
        raise SystemExit(2)
